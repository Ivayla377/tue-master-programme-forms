      "name": "rule_free_elective_space_min_credits",
      "expression": "35",
      "includeIntoResult": true
    },
    {
      "name": "rule_homologation_max_credits",
      "expression": "15",
      "includeIntoResult": true
    },
    {
      "name": "rule_internship_credits",
      "expression": "15",
      "includeIntoResult": true
    },
    {
      "name": "mandatory_fixed_credits",
      "expression": "{rule_mandatory_credits} - {rule_graduation_credits}",
      "includeIntoResult": true
    },
    {
      "name": "graduation_credits",
      "expression": "iif({graduation_course_set} notempty, {rule_graduation_credits}, 0)",
      "includeIntoResult": true
    },
    {
      "name": "mandatory_credits",
      "expression": "{mandatory_fixed_credits} + {graduation_credits}",
      "includeIntoResult": true
    },
    {
      "name": "ist_elective_count",
      "expression": "count({ist_electives})",
      "includeIntoResult": true
    },
    {
      "name": "ist_elective_credits",
      "expression": "{ist_elective_count} * {rule_standard_course_credits}",
      "includeIntoResult": true
    },
    {
      "name": "mcs_course_count",
      "expression": "count({mcs_course_electives})",
      "includeIntoResult": true
    },
    {
      "name": "mcs_course_credits",
      "expression": "{mcs_course_count} * {rule_standard_course_credits}",
      "includeIntoResult": true
    },
    {
      "name": "manual_mcs_elective_credits",
      "expression": "iif({other_mcs_courses} = true, sumInArray({mcs_other_courses}, 'credits', {code} notempty and {title} notempty and {credits} > 0), 0)",
      "includeIntoResult": true
    },
    {
      "name": "internship_credits",
      "expression": "iif({internship} = true, {rule_internship_credits}, 0)",
      "includeIntoResult": true
    },
    {
      "name": "mcs_elective_credits",
      "expression": "{mcs_course_credits} + {manual_mcs_elective_credits} + {internship_credits}",
      "includeIntoResult": true
    },
    {
      "name": "manual_free_elective_credits",
      "expression": "sumInArray({free_electives}, 'credits', {code} notempty and {title} notempty and {credits} > 0)",
      "includeIntoResult": true
    },
    {
      "name": "homologation_course_credits",
      "expression": "iif({homologation} = true, sumInArray({homologation_courses}, 'credits', {code} notempty and {title} notempty and {credits} > 0), 0)",
      "includeIntoResult": true
    },
    {
      "name": "homologation_credits",
      "expression": "{homologation_course_credits}",
      "includeIntoResult": true
    },
    {
      "name": "other_free_elective_credits",
      "expression": "{manual_free_elective_credits} + {homologation_credits}",
      "includeIntoResult": true
    },
    {
      "name": "free_elective_space_credits",
      "expression": "{mcs_elective_credits} + {other_free_elective_credits}",
      "includeIntoResult": true
    },
    {
      "name": "total_programme_credits",
      "expression": "{mandatory_credits} + {ist_elective_credits} + {free_elective_space_credits}",
      "includeIntoResult": true
    }
  ]
}
