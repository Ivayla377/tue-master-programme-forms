{
  "title": "Form 1: CSE Program of Examinations",
  "description": "This form is used to create a report that shows your current study program. Its purpose is to be shared with the examination committee, so that they can check whether it satisfies the requirements of Computer Science and Engineering programs and approve it or inform you of how it does not satisfy the requirements. This form has built-in validation that should help you create a valid study program. Please complete it at least six weeks before the start of the preparation graduation project.",
  "completedHtml": "",
  "showCompletePage": false,
  "clearInvisibleValues": "onHidden",
  "showProgressBar": "top",
  "progressBarType": "pages",
  "pages": [
    {
      "name": "frontmatter",
      "title": "General information",
      "elements": [
        {
          "type": "multipletext",
          "name": "personal_info",
          "title": "Personal information",
          "isRequired": true,
          "items": [
            {
              "name": "name",
              "title": "Name",
              "isRequired": true,
              "placeholder": "Surname, Given name(s)"
            },
            {
              "name": "id",
              "title": "Student ID",
              "isRequired": true,
              "maskType": "pattern",
              "maskSettings": {
                "pattern": "9999999"
              },
              "maxLength": 7,
              "inputSize": 7,
              "validators": [
                {
                  "type": "regex",
                  "text": "Your student ID must be a 7-digit number.",
                  "regex": "\\d{7}"
                }
              ]
            },
            {
              "name": "enrollment",
              "title": "Month and year of enrollment",
              "isRequired": true,
              "inputType": "month",
              "validators": [
                {
                  "type": "regex",
                  "text": "Enter a valid enrollment month from 2010 to 2035.",
                  "regex": "^(?:201[0-9]|202[0-9]|203[0-5])-(?:0[1-9]|1[0-2])$"
                }
              ]
            }
          ]
        },
        {
          "type": "panel",
          "name": "graduation_group_panel",
          "title": "Graduation group",
          "elements": [
            {
              "type": "dropdown",
              "name": "graduation_group",
              "title": "Intended graduation group",
              "isRequired": true,
              "choices": [
                {
                  "value": "algorithms",
                  "text": "Algorithms"
                },
                {
                  "value": "formal_systems_analysis",
                  "text": "Formal Systems Analysis"
                },
                {
                  "value": "security",
                  "text": "Security"
                },
                {
                  "value": "software_engineering_technology",
                  "text": "Software Engineering and Technology"
                },
                {
                  "value": "iris",
                  "text": "Interconnected Resource-aware Intelligent Systems"
                },
                {
                  "value": "dai_databases",
                  "text": "Data and Artificial Intelligence - Databases"
                },
                {
                  "value": "dai_other",
                  "text": "Data and Artificial Intelligence - Other groups"
                },
                {
                  "value": "process_analytics",
                  "text": "Process Analytics"
                },
                {
                  "value": "visualization",
                  "text": "Visualization"
                },
                {
                  "value": "discrete_mathematics",
                  "text": "Discrete Mathematics"
                }
              ]
            },
            {
              "type": "text",
              "name": "research_cluster",
              "title": "Name of representative research cluster",
              "description": "Enter the official name if it is already known.",
              "placeholder": "Research cluster name"
            }
          ]
        },
        {
          "type": "panel",
          "name": "previous_panel",
          "elements": [
            {
              "type": "boolean",
              "name": "previous",
              "title": "Is this a change to a previously approved program?",
              "isRequired": true
            },
            {
              "type": "comment",
              "name": "changes",
              "visibleIf": "{previous} = true",
              "title": "What has changed?",
              "isRequired": true,
              "requiredIf": "{previous} = true"
            }
          ]
        }
      ]
    },
