                },
                {
                  "name": "credits",
                  "title": "ECTS",
                  "isRequired": true,
                  "width": "6em",
                  "cellType": "text"
                }
              ],
              "rowCount": 0,
              "maxRowCount": 3,
              "confirmDelete": true,
              "addRowText": "Add homologation course",
              "confirmDeleteText": "Remove this homologation course?"
