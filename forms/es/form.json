                  "value": "2imf30",
                  "text": "2IMF30 System Validation (5 ECTS)"
                },
                {
                  "value": "5sia0",
                  "text": "5SIA0 Embedded Computer Architecture (5 ECTS)"
                },
                {
                  "value": "2imn20",
                  "text": "2IMN20 Real-Time Systems (5 ECTS)"
