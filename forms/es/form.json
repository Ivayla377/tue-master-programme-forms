    {
      "name": "free_space",
      "title": "Free-elective space",
      "description": "The free-elective space is 25 ECTS. It can be filled with free electives, homologation courses or an internship.",
      "elements": [
        {
          "type": "matrixdynamic",
          "name": "free_electives",
          "title": "Free electives",
          "description": "Free elective courses can be any master-level courses from the TU/e or another university. In case a free elective was followed at another university, please add its name between parentheses to the course name.",
          "columns": [
            {
              "name": "code",
              "title": "Course code",
              "isRequired": true,
              "isUnique": true,
              "width": "8em",
              "cellType": "text",
              "inputType": "text"
            },
            {
              "name": "title",
              "title": "Course title",
              "isRequired": true,
              "cellType": "text",
              "inputType": "text"
            },
            {
              "name": "credits",
              "title": "ECTS",
              "isRequired": true,
              "width": "6em",
              "cellType": "text",
              "inputType": "text",
              "totalType": "sum",
              "totalDisplayStyle": "decimal"
            }
          ],
          "rowCount": 0,
          "confirmDelete": true,
          "addRowText": "Add free elective",
          "confirmDeleteText": "Remove this free elective?"
        },
        {
          "type": "panel",
          "name": "homologation_panel",
          "title": "Homologation courses",
          "description": "Homologation courses are bachelor courses assigned during the admission process to make up deficiencies in previous knowledge. They may be at most 15 ECTS in total.",
          "elements": [
            {
              "type": "boolean",
              "name": "homologation",
              "title": "Do you include homologation courses?",
              "description": "Please check your admission letter to see if you have homologation courses. Self-chosen bachelor courses are recorded separately below.",
              "isRequired": true
            },
            {
              "type": "matrixdynamic",
              "name": "assigned_homologation_courses",
              "visibleIf": "{homologation} = true",
              "title": "Assigned homologation courses",
              "columns": [
                { "name": "code", "title": "Course code", "isRequired": true, "isUnique": true, "width": "8em", "cellType": "text" },
                { "name": "title", "title": "Course title", "isRequired": true, "cellType": "text" },
                { "name": "credits", "title": "ECTS", "isRequired": true, "width": "6em", "cellType": "text" }
              ],
              "rowCount": 0,
              "confirmDelete": true,
              "addRowText": "Add assigned course",
              "confirmDeleteText": "Remove this assigned course?"
            },
            {
              "type": "boolean",
              "name": "self_chosen_homologation",
              "visibleIf": "{homologation} = true",
              "title": "Do you include self-chosen bachelor courses to compensate deficiencies?",
              "description": "A maximum of three self-chosen bachelor courses are allowed. Please write a motivation for choosing each.",
              "isRequired": true,
              "requiredIf": "{homologation} = true"
            },
            {
              "type": "matrixdynamic",
              "name": "self_chosen_homologation_courses",
              "visibleIf": "{homologation} = true and {self_chosen_homologation} = true",
              "title": "Self-chosen homologation courses",
              "description": "Add no more than three courses.",
              "isRequired": true,
              "requiredIf": "{homologation} = true and {self_chosen_homologation} = true",
              "columns": [
                { "name": "code", "title": "Course code", "isRequired": true, "isUnique": true, "width": "8em", "cellType": "text" },
                { "name": "title", "title": "Course title", "isRequired": true, "cellType": "text" },
                { "name": "credits", "title": "ECTS", "isRequired": true, "width": "6em", "cellType": "text" }
              ],
              "rowCount": 0,
              "maxRowCount": 3,
              "confirmDelete": true,
              "addRowText": "Add self-chosen course",
              "confirmDeleteText": "Remove this self-chosen course?"
            },
            {
              "type": "comment",
              "name": "homologation_motivation",
              "visibleIf": "{homologation} = true and {self_chosen_homologation} = true",
              "title": "Motivation for self-chosen homologation courses",
              "description": "Explain the deficiency addressed by each self-chosen bachelor course.",
              "isRequired": true,
              "requiredIf": "{homologation} = true and {self_chosen_homologation} = true"
            }
          ]
        },
        {
          "type": "panel",
          "name": "internship_panel",
          "title": "Internship",
          "description": "An internship is optional and contributes 15 ECTS inside the free-elective space.",
          "elements": [
            {
              "type": "boolean",
              "name": "internship",
              "title": "Do you include an internship?",
              "isRequired": true
            },
            {
              "type": "radiogroup",
              "name": "internship_code",
              "visibleIf": "{internship} = true",
              "title": "Internship course code",
              "description": "Use the registration code confirmed by your supervisor or programme.",
              "isRequired": true,
              "requiredIf": "{internship} = true",
              "choices": [
                { "value": "2imc10", "text": "2IMC10 Internship (15 ECTS)" },
                { "value": "5l990", "text": "5L990 Internship (15 ECTS)" }
              ]
            },
            {
              "type": "radiogroup",
              "name": "internship_type",
              "visibleIf": "{internship} = true",
              "title": "Internship type",
              "isRequired": true,
              "requiredIf": "{internship} = true",
              "choices": [
                { "value": "internal", "text": "Internal internship (within TU/e)" },
                { "value": "external", "text": "External internship (for example, at a company)" }
              ]
            },
            {
              "type": "text",
              "name": "internship_supervisor",
              "visibleIf": "{internship} = true",
              "title": "Internship supervisor (if known)",
              "placeholder": "Supervisor name"
            }
          ]
        }
      ]
    },
    {
      "name": "additional_information",
      "title": "Additional information",
      "elements": [
        {
          "type": "comment",
          "name": "changes",
          "visibleIf": "{previous} = true",
          "title": "Changes to the previously approved program",
          "description": "List each change clearly. A revised programme for other reasons may also require the separate university change form at the start of the preparation phase.",
          "isRequired": true,
          "requiredIf": "{previous} = true"
        },
        {
          "type": "boolean",
          "name": "external_courses",
          "title": "Does the proposed program include a course from another university?",
          "description": "Answer Yes for every external-university course. Selecting 2IMNT1 requires a Yes answer and the supporting information below because it is offered by the University of Twente.",
          "isRequired": true
        },
        {
          "type": "text",
          "name": "external_course_university",
          "visibleIf": "{external_courses} = true or {stream_electives_systems_on_chip} contains '2imnt1'",
          "title": "External university or universities",
          "isRequired": true,
          "requiredIf": "{external_courses} = true or {stream_electives_systems_on_chip} contains '2imnt1'",
          "placeholder": "University name(s)"
        },
        {
          "type": "comment",
          "name": "external_course_links",
