              "choices": [
                {
                  "value": "5t514",
                  "text": "5T514 Preparation Graduation Project ES 'Electrical Engineering' (10 ECTS)"
                },
                {
                  "value": "5t746",
                  "text": "5T746 Graduation Project ES 'Electrical Engineering' (30 ECTS)"
                }
              ]
            }
          ]
        }
      ]
