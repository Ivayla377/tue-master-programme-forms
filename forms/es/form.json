  "headerView": "advanced",
  "calculatedValues": [
    {
      "name": "rule_programme_target",
      "expression": "120",
      "includeIntoResult": true
    },
    {
      "name": "rule_standard_course_credits",
      "expression": "5",
      "includeIntoResult": true
    },
    {
      "name": "rule_common_mandatory_credits",
      "expression": "25",
      "includeIntoResult": true
    },
    {
      "name": "rule_stream_mandatory_credits",
      "expression": "15",
      "includeIntoResult": true
    },
    {
      "name": "rule_stream_elective_target",
      "expression": "15",
      "includeIntoResult": true
    },
    {
      "name": "rule_free_elective_space_target",
      "expression": "25",
      "includeIntoResult": true
    },
    {
      "name": "rule_preparation_project_credits",
      "expression": "10",
      "includeIntoResult": true
    },
    {
      "name": "rule_graduation_project_credits",
      "expression": "30",
      "includeIntoResult": true
    },
    {
      "name": "rule_graduation_phase_credits",
      "expression": "40",
      "includeIntoResult": true
    },
    {
      "name": "rule_internship_credits",
      "expression": "15",
      "includeIntoResult": true
    },
    {
      "name": "rule_homologation_max_credits",
      "expression": "15",
      "includeIntoResult": true
    },
    {
      "name": "rule_self_chosen_homologation_max_courses",
      "expression": "3",
      "includeIntoResult": true
    },
    {
      "name": "credits_common_mandatory",
      "expression": "{rule_common_mandatory_credits}",
      "includeIntoResult": true
    },
    {
      "name": "credits_stream_mandatory",
      "expression": "iif({stream} notempty, {rule_stream_mandatory_credits}, 0)",
      "includeIntoResult": true
    },
    {
      "name": "credits_stream_electives_selected",
      "expression": "iif({stream} = 'systems_on_chip', count({stream_electives_systems_on_chip}) * {rule_standard_course_credits}, iif({stream} = 'embedded_software', count({stream_electives_embedded_software}) * {rule_standard_course_credits}, iif({stream} = 'embedded_networking', count({stream_electives_embedded_networking}) * {rule_standard_course_credits}, iif({stream} = 'cyber_physical_systems', count({stream_electives_cyber_physical_systems}) * {rule_standard_course_credits}, 0))))",
      "includeIntoResult": true
    },
    {
      "name": "credits_stream_electives_required",
      "expression": "iif({credits_stream_electives_selected} > {rule_stream_elective_target}, {rule_stream_elective_target}, {credits_stream_electives_selected})",
      "includeIntoResult": true
    },
    {
      "name": "credits_stream_electives_excess",
      "expression": "{credits_stream_electives_selected} - {credits_stream_electives_required}",
      "includeIntoResult": true
    },
    {
      "name": "credits_free_rows",
      "expression": "sumInArray({free_electives}, 'credits', {code} notempty and {title} notempty and {credits} > 0)",
      "includeIntoResult": true
    },
    {
      "name": "credits_homologation",
      "expression": "iif({homologation} = true, sumInArray({homologation_courses}, 'credits', {code} notempty and {title} notempty and {credits} > 0), 0)",
      "includeIntoResult": true
    },
    {
      "name": "credits_internship",
      "expression": "iif({internship} = true and {internship_code} notempty and {internship_type} notempty, {rule_internship_credits}, 0)",
      "includeIntoResult": true
    },
    {
      "name": "credits_free_space",
      "expression": "{credits_stream_electives_excess} + {credits_free_rows} + {credits_homologation} + {credits_internship}",
      "includeIntoResult": true
    },
    {
      "name": "credits_preparation_project",
      "expression": "iif({graduation_context} notempty, {rule_preparation_project_credits}, 0)",
      "includeIntoResult": true
    },
    {
      "name": "credits_graduation_project",
      "expression": "iif({graduation_context} notempty, {rule_graduation_project_credits}, 0)",
      "includeIntoResult": true
    },
    {
      "name": "credits_graduation_phase",
      "expression": "{credits_preparation_project} + {credits_graduation_project}",
      "includeIntoResult": true
    },
    {
      "name": "credits_mandatory_and_graduation",
      "expression": "{credits_common_mandatory} + {credits_graduation_phase}",
      "includeIntoResult": true
    },
    {
      "name": "credits_total",
      "expression": "{credits_common_mandatory} + {credits_stream_mandatory} + {credits_stream_electives_required} + {credits_free_space} + {credits_graduation_phase}",
      "includeIntoResult": true
    }
  ]
}
