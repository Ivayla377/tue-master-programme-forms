{
  "name": "tue-program-of-examinations-forms",
  "version": "0.1.0",
  "private": true,
  "description": "Offline SurveyJS Program of Examinations forms for TU/e master programs.",
  "type": "module",
  "imports": {
    "#forms/*": "./forms/*/2025-2026/form.json"
  },
  "scripts": {
    "dev": "node scripts/dev-program.mjs",
    "build": "node scripts/build-program.mjs dsai",
    "build:program": "node scripts/build-program.mjs",
    "build:dsai": "node scripts/build-program.mjs dsai",
    "build:cse": "node scripts/build-program.mjs cse",
    "build:es": "node scripts/build-program.mjs es",
    "build:iam": "node scripts/build-program.mjs iam",
    "build:cybr": "node scripts/build-program.mjs cybr",
    "build:all": "node scripts/build-all.mjs",
    "test": "node --test",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "survey-core": "^2.0.0",
    "survey-js-ui": "^2.0.0"
  },
  "devDependencies": {
    "sass": "^1.89.0",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
